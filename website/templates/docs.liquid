        <article>
            <a href="docs/{{ doc.Slug }}.html">
                <header>
                    <span>{{ doc.Title }}</span>
                </header>
                <p>{{ doc.Description }}</p>
            </a>
        </article>
        </li>
    {% endfor %}
    </menu>
</section>