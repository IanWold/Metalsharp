{% assign directoryPrefix = "" %}
{% for i in (1..level) %}
{% assign directoryPrefix = directoryPrefix | append: "../" %}
{% endfor %}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Metalsharp</title>
<link rel="stylesheet" href="{{ directoryPrefix }}static/style.css">
</head>
<body>

